# Auto-detect text files and normalize line endings
* text=auto

# Explicit line ending normalization
*.php text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.dist text eol=lf

# Images as binary
*.jpg binary
*.png binary
*.gif binary
*.svg binary
*.ico binary

# Export ignore — only ship plugin files, not dev tooling
/.gitattributes export-ignore
/.gitignore export-ignore
/composer.lock export-ignore
/composer.phar export-ignore
/phpcs.xml.dist export-ignore