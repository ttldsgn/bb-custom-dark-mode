<?xml version="1.0"?>
<ruleset name="BB Custom Dark Mode">
    <description>WordPress Coding Standards for BB Custom Dark Mode plugin.</description>

    <!-- Scan all PHP files in this directory and subdirectories. -->
    <file>.</file>

    <!-- Exclude third-party, build, and test directories. -->
    <exclude-pattern>/vendor/</exclude-pattern>
    <exclude-pattern>/node_modules/</exclude-pattern>
    <exclude-pattern>/tests/</exclude-pattern>
    <exclude-pattern>/assets/</exclude-pattern>

    <!-- Exclude minified or bundled JS/CSS files. -->
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>

    <!-- Configure the text domain for i18n checks. -->
    <config name="text_domain" value="bb-dark-mode"/>

    <!-- Enable colors, show sniff codes, show progress. -->
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="psv"/>

    <!-- WordPress coding standards rulesets. -->
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>
</ruleset>